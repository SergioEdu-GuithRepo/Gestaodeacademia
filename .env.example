# Copiar para .env e ajustar
DATABASE_URL="postgresql://academia:academia@localhost:5435/academia?schema=public"

# Fuso horário de apresentação (Angola)
APP_TIMEZONE="Africa/Luanda"

# Segredo para cifrar credenciais (ex.: chave da Evolution API). Obrigatório em produção.
# Gerar com: openssl rand -base64 48
APP_SECRET=""

# URL público da aplicação (links nas mensagens e URL do webhook). Opcional em desenvolvimento.
APP_URL="http://localhost:3000"

# Chave mestra do Painel Super-Admin da Plataforma (/plataforma).
# Em desenvolvimento, se vazia, usa "superadmin123". Obrigatória em produção.
SUPERADMIN_SECRET=""

# Servidor global Evolution API da plataforma (Railway).
# Quando definido, os centros de formação não precisam de configurar URL nem API Key — apenas leem o QR Code.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
